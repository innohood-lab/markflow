{
  "name": "@markflow/desktop",
  "version": "0.1.0",
  "description": "MarkFlow Desktop App",
  "main": "./out/main/index.js",
  "author": "Kyujin Park <innohood@gmail.com>",
  "scripts": {
    "postinstall": "node ./node_modules/electron/install.js",
    "dev": "node ./node_modules/electron/install.js && electron-vite dev --watch -c electron-vite.config.ts",
    "build": "electron-vite build -c electron-vite.config.ts",
    "preview": "electron-vite preview -c electron-vite.config.ts",
    "test": "vitest run",
    "build:unpack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "11.8.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
