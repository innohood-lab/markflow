{
  "name": "markflow-root",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @markflow/desktop dev",
    "build": "pnpm --filter @markflow/desktop build",
    "build:engine": "cd engine && uv run python build_sidecar.py",
    "build:all": "pnpm build:engine && pnpm build",
    "dist": "pnpm --filter @markflow/desktop dist",
    "dist:win": "pnpm --filter @markflow/desktop dist:win",
    "dist:mac": "pnpm --filter @markflow/desktop dist:mac",
    "test": "pnpm --filter @markflow/desktop test",
    "test:engine": "cd engine && uv run pytest",
    "test:all": "pnpm test && pnpm test:engine"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1"
  }
}
